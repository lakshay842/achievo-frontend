{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/goals/create", "destination": "/goals/create.html" },
    { "source": "/goals/clarification", "destination": "/goals/clarification.html" },
    { "source": "/goals/roadmap-preview", "destination": "/goals/roadmap-preview.html" },
    { "source": "/goals/:goalId", "destination": "/goals/_goalId" },
    { "source": "/tasks/:taskId", "destination": "/tasks/_taskId" },
    { "source": "/((?!_expo/).*)", "destination": "/index.html" }
  ]
}
