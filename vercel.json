{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/goals/:goalId", "destination": "/goals/[goalId].html" },
    { "source": "/tasks/:taskId", "destination": "/tasks/[taskId].html" }
  ]
}
